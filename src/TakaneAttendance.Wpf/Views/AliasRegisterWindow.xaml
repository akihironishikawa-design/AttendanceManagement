<Window x:Class="TakaneAttendance.Wpf.Views.AliasRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="別名マスタへ登録" Width="520" Height="520"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="White"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="12">

  <DockPanel Margin="14,12,14,12">

    <!-- 対象の未解決氏名 -->
    <Border DockPanel.Dock="Top" Background="{StaticResource ErrorBg}" BorderBrush="#E8C0B8"
            BorderThickness="1" CornerRadius="3" Padding="10,7">
      <StackPanel>
        <TextBlock x:Name="SourceText" FontWeight="Bold" FontSize="14"
                   Foreground="{StaticResource Blue900}" TextWrapping="Wrap"/>
        <TextBlock x:Name="OriginText" Foreground="{StaticResource SubBrush}" FontSize="11"
                   Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- 操作ボタン -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="マスタに登録" Style="{StaticResource PrimaryButton}" Click="Ok_Click"
              IsDefault="True" MinWidth="110"/>
      <Button Content="キャンセル" Style="{StaticResource SubButton}" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
    </StackPanel>

    <!-- 登録内容 -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock Text="正式氏名(打刻データに登録されている氏名)" FontWeight="Bold"
                 Foreground="{StaticResource Blue900}" Margin="0,0,0,4"/>
      <TextBox x:Name="CanonicalBox" Padding="6,4" FontSize="14"/>
      <TextBlock Foreground="{StaticResource SubBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="下の候補から選ぶか、直接入力してください。空欄のまま登録すると「この表記自体が正式氏名」として登録されます。"/>
    </StackPanel>

    <!-- 候補 -->
    <DockPanel Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Top" Text="候補(打刻データの社員)" FontWeight="Bold"
                 Foreground="{StaticResource Blue900}" Margin="0,0,0,4"/>
      <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Padding="6,4" Margin="0,0,0,6"
               TextChanged="FilterBox_TextChanged"
               ToolTip="氏名・作業番号・部門で絞り込みます"/>
      <ListBox x:Name="CandidateList" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
               SelectionChanged="CandidateList_SelectionChanged"
               MouseDoubleClick="CandidateList_MouseDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="{Binding EmployeeNo}" Foreground="{StaticResource SubBrush}"/>
              <TextBlock Grid.Column="2" Text="{Binding Department}" Foreground="{StaticResource SubBrush}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

  </DockPanel>
</Window>
