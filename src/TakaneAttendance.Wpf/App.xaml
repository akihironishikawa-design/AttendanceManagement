<Application x:Class="TakaneAttendance.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TakaneAttendance.Wpf"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <local:InverseBoolConverter x:Key="InverseBool"/>
    <local:NotNullConverter x:Key="NotNull"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- 業務システムらしい落ち着いた青系の配色 -->
    <SolidColorBrush x:Key="Blue900" Color="#0F2F5C"/>
    <SolidColorBrush x:Key="Blue700" Color="#1E5AA8"/>
    <SolidColorBrush x:Key="Blue100" Color="#E3EDF8"/>
    <SolidColorBrush x:Key="Blue050" Color="#F2F7FC"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D4DFE9"/>
    <SolidColorBrush x:Key="InkBrush" Color="#22303F"/>
    <SolidColorBrush x:Key="SubBrush" Color="#5B6B7C"/>

    <!-- 判定の重大度ごとの行の背景色 -->
    <SolidColorBrush x:Key="ErrorBg"   Color="#FBE4E0"/>
    <SolidColorBrush x:Key="ReviewBg"  Color="#FDF1DC"/>
    <SolidColorBrush x:Key="WarningBg" Color="#F0ECFB"/>
    <SolidColorBrush x:Key="InfoBg"    Color="#EDF3F8"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Blue900}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Blue700}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A6BBF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#B7C4D2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SubButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#7D93AA"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="12,5"/>
    </Style>

  </Application.Resources>
</Application>
