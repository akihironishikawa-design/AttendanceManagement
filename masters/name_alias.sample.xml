<?xml version="1.0" encoding="utf-8"?>
<!--
  社員名 別名マスタ の見本

  実在の社員名を含む name_alias.xml はリポジトリに含めていません。
  このファイルを name_alias.xml という名前で複製し、実際の対応に置き換えてください。

  シフト表には「山田 部長」のように役職で書かれた氏名があり、
  打刻データの「山田 太郎」とは文字列が一致しないため、この表で対応づける。

  書式: <alias source="表記" canonical="正式氏名" note="備考"/>
    ・source    = シフト表など、突合したい側に書かれている氏名
    ・canonical = タイムレコーダー(打刻データ)に登録されている氏名
    ・note      = 備考(処理には使わない)
    ・canonical を省略した行は「正式氏名そのものの登録」として扱われる

  空白(半角/全角)の違いだけの表記ゆれは、打刻データの氏名から自動で解決されるため
  ここに書く必要はない。

  下の氏名はすべて架空の人物です。
-->
<nameAliases>

  <!-- 役職での表記 -->
  <alias source="山田 部長" canonical="山田 太郎" note="例) 打刻データ内の「山田」が1名のみの場合"/>
  <alias source="鈴木 課長" canonical="鈴木 一郎" note="例) 同上"/>

  <!-- 異体字。帳票によって表記が分かれる場合 -->
  <alias source="髙橋 健二" canonical="高橋 健二" note="例) 異体字(髙/高)"/>

  <!-- 正式氏名そのものの登録(canonical を省略する) -->
  <alias source="佐藤 花子" note="例) 表記ゆれのない方を明示的に登録する場合"/>

</nameAliases>
